{
  "//": "Bulwark TypeScript config. Extends Nuxt's auto-generated tsconfig; adds project-wide path aliases for shared/ and server/.",
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~": ["./app"],
      "~/*": ["./app/*"],
      "@": ["./app"],
      "@/*": ["./app/*"],
      "~~": ["./"],
      "~~/*": ["./*"],
      "@@": ["./"],
      "@@/*": ["./*"],
      "#shared": ["./shared"],
      "#shared/*": ["./shared/*"],
      "#app": ["./node_modules/nuxt/dist/app"],
      "#app/*": ["./node_modules/nuxt/dist/app/*"],
      "#imports": ["./.nuxt/imports.d.ts"]
    }
  },
  "include": [
    ".nuxt/nuxt.d.ts",
    "app/**/*",
    "server/**/*",
    "shared/**/*",
    "tests/**/*",
    "nuxt.config.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".output", "dist", "demo", "boilerplate"]
}
