{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bulwark work-packages registry",
  "type": "object",
  "required": ["version", "packages"],
  "properties": {
    "version": { "type": "string" },
    "legend": { "type": "object" },
    "rules": { "type": "array", "items": { "type": "string" } },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "lane", "phase", "status", "size", "goal", "files", "acceptance", "tests", "dependsOn"],
        "properties": {
          "id": { "type": "string", "pattern": "^WP-[A-Z]+[0-9]*$" },
          "title": { "type": "string" },
          "lane": { "enum": ["DS", "SCR", "BE", "QA", "HRD", "OPS"] },
          "phase": { "enum": ["0-foundation", "1-shared", "2-admin-core", "3-admin-rest", "4-portals", "5-settings", "6-modules", "7-docs-longterm"] },
          "status": { "enum": ["todo", "ready", "in-progress", "review", "blocked", "done"] },
          "size": { "enum": ["S", "M", "L", "XL"] },
          "goal": { "type": "string" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "outOfScope": { "type": "array", "items": { "type": "string" } },
          "designs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2,3}-[0-9]{2}[a-z]?$" } },
          "designAhead": { "type": "boolean" },
          "files": { "type": "array", "items": { "type": "string" } },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "tests": { "type": "array", "items": { "type": "string" } },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "decisions": { "type": "array", "items": { "type": "string", "pattern": "^ED-[0-9A-Z]{3}$" } },
          "agentNotes": { "type": "string" },
          "owner": { "type": "string", "description": "agent/human currently holding the WP (set when in-progress)" },
          "branch": { "type": "string" },
          "pr": { "type": "string" }
        }
      }
    }
  }
}
