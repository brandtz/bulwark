# Bulwark environment example
# Copy to .env.local and fill in values for local dev.
# Real production secrets live in Vercel project settings (TECH §11).

# ADR-0004: 'mock' uses MockServiceFactory; 'real' uses RealServices (E11+)
BULWARK_BACKEND=mock

# Session encryption key for nuxt-auth-utils. 32+ chars required.
# Generate: openssl rand -hex 32
NUXT_SESSION_PASSWORD=replace-with-32-char-or-longer-random-string

# Postgres — only required when BULWARK_BACKEND=real (E11+)
DATABASE_URL=postgres://bulwark:bulwark@localhost:5432/bulwark_dev

# JWT secret for mobile/PWA clients (E11)
JWT_SECRET=replace-with-32-char-or-longer-random-string

# Cloudflare R2 (E11 / E7)
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_KEY=
CLOUDFLARE_R2_SECRET=

# Phase 2+
RESEND_API_KEY=
STRIPE_SECRET_KEY=
