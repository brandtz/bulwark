# Bulwark environment example
# Copy to .env.local and fill in values for local dev.
# Real production secrets live in deploy-target project settings
# (Vercel / Render / Netlify) — never in this file or any tracked file.
# Generation hints: `openssl rand -hex 32` for any 32-byte secret.
#
# This file is the canonical list of env vars Bulwark reads at runtime.
# W5-2 / ADR-0036 — anything new the codebase consults via `process.env.*`
# must be added here with a one-line comment.

# --------------------------------------------------------------------------
# Core
# --------------------------------------------------------------------------
# ADR-0015: 'real' uses Postgres + Drizzle backend; 'mock' is offline demo.
BULWARK_BACKEND=real
# Defaults to 'dev'; set in CI/prod images so /api/health reports a real tag.
BULWARK_VERSION=dev
# Reserved for Vercel preset detection (set automatically by Vercel CI).
# VERCEL=1

# --------------------------------------------------------------------------
# Sessions / auth
# --------------------------------------------------------------------------
# Session cookie encryption key for nuxt-auth-utils. 32+ chars required.
NUXT_SESSION_PASSWORD=replace-with-32-char-or-longer-random-string
# JWT signing secret + AES-GCM key seed for at-rest encryption (ADR-0024 /
# ADR-0036). 32+ chars required.
JWT_SECRET=replace-with-32-char-or-longer-random-string
# Optional override for AES-GCM at-rest encryption key (ADR-0036). If unset,
# the platform falls back to JWT_SECRET. Recommended for production so
# JWT signing and at-rest encryption can be rotated independently.
BULWARK_ENCRYPTION_KEY=

# --------------------------------------------------------------------------
# Postgres (ADR-0012)
# --------------------------------------------------------------------------
# Required when BULWARK_BACKEND=real.
DATABASE_URL=postgresql://bulwark_app:REPLACE_ME@localhost:5432/bulwark_dev
# Optional dev fuse — set to '1' to allow `pnpm db:seed` against a prod-
# looking DATABASE_URL. Default OFF.
BULWARK_ALLOW_PROD_SEED=

# --------------------------------------------------------------------------
# Observability (ADR-0034)
# --------------------------------------------------------------------------
# debug | info | warn | error. Default: info.
BULWARK_LOG_LEVEL=info

# --------------------------------------------------------------------------
# Security / hardening (W5-1, W5-2)
# --------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins. Empty = same-origin only.
BULWARK_CORS_ORIGINS=
# Set to '1' to bypass rate-limiting (local dev / load tests only).
BULWARK_RATE_LIMIT_DISABLED=

# --------------------------------------------------------------------------
# Notifications (ADR-0027)
# --------------------------------------------------------------------------
# '1' = stub all outbound email/SMS. Auto-on in NODE_ENV=test.
BULWARK_NOTIFICATIONS_DISABLED=
# Resend API key — only used as a fallback if no provider_configs row of
# kind='email' provider='resend' is active for the calling org. Prefer
# the per-org admin UI; this env path is for single-tenant smoke tests.
RESEND_API_KEY=

# --------------------------------------------------------------------------
# Compliance PDF / jobs
# --------------------------------------------------------------------------
# '1' = use the deterministic PDF stub instead of headless Chrome.
BULWARK_PDF_STUB=

# --------------------------------------------------------------------------
# Cloudflare R2 (E11 / E7)
# --------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bulwark-compliance-docs
R2_ENDPOINT=
R2_PUBLIC_URL=

# --------------------------------------------------------------------------
# Stripe (E13-S7 homeowner pay-link). Test keys only in .env.local.
# --------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
